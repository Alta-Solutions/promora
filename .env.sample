# BigCommerce API
BC_STORE_HASH=
BC_CLIENT_ID= #from Bigcommerce dev portal
BC_CLIENT_SECRET= #from Bigcommerce dev portal
BC_ACCESS_TOKEN=

# Database
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# App Settings
APP_URL=http://localhost
ADMIN_USERNAME=  #for super admin login
ADMIN_PASSWORD=   #for super admin login (password hashed with password_hash())
# HTTP worker and scheduler credential sent in X-Cron-Token
CRON_AUTH_TOKEN=
SECRET_CRON_KEY= #random secret

# Custom Field
CUSTOM_FIELD_NAME= #custom field name to store promotion

# Session
SESSION_LIFETIME=3600
# Optional: set to true only if HTTPS is terminated before PHP and HTTPS headers are unavailable.
# SESSION_COOKIE_SECURE=true

# Queue worker
# Maximum webhook events processed from one webhook_event job before yielding to higher-priority jobs.
WEBHOOK_EVENT_BATCH_LIMIT=25

# Omnibus
# Hour of day when scheduler should create the daily full Omnibus sync. Defaults to 2.
OMNIBUS_FULL_SYNC_HOUR=2

#OMNIBUS_TEST_REMOTE_SYNC=1

# Restrict worker claims during rollout (comma-separated store hashes). Empty processes all stores.
PROMORA_WORKER_STORES=
# Optional absolute writable path outside the document root.
# PROMORA_LOG_DIR=
# Optional diagnostic window, ending at the specified ISO-8601 time (maximum 30 minutes).
# PROMORA_DEBUG_STORE=
# PROMORA_DEBUG_OPERATION=GET catalog/products/{id}
# PROMORA_DEBUG_UNTIL=
# Set to 0 to use individual item history queries during comparison.
PROMORA_GROUP_HISTORY=1
