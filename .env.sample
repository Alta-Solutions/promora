# BigCommerce API
BC_STORE_HASH=
BC_CLIENT_ID= #from Bigcommerce dev portal
BC_CLIENT_SECRET= #from Bigcommerce dev portal
BC_ACCESS_TOKEN=

# Database
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# App Settings
APP_URL=http://localhost
ADMIN_USERNAME=  #for super admin login
ADMIN_PASSWORD=   #for super admin login (password hashed with password_hash())
SECRET_CRON_KEY= #random secret

# Custom Field
CUSTOM_FIELD_NAME= #custom field name to store promotion

# Session
SESSION_LIFETIME=3600

# Log rotation
# Defaults: 52428800 bytes (50 MB), 5 rotated files per log.
LOG_ROTATION_MAX_BYTES=52428800
LOG_ROTATION_MAX_FILES=5
# Optional: set to true only if HTTPS is terminated before PHP and HTTPS headers are unavailable.
# SESSION_COOKIE_SECURE=true

#OMNIBUS_TEST_REMOTE_SYNC=1
